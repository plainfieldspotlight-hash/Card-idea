// Idea Loop data model. See SPEC.md, "Data model".
// Five tables: sources, goals, ideas, tags + idea_tags, applications.
// Every table has id, created_at, updated_at.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Source {
  id        String   @id @default(cuid())
  title     String
  type      String   // book | article | podcast | person | other
  url       String?
  author    String?
  rawText   String?  @map("raw_text") // imported content for depth on demand
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ideas Idea[]

  @@map("sources")
}

model Goal {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("active") // active | done | paused
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ideas Idea[]

  @@map("goals")
}

model Idea {
  id                  String    @id @default(cuid())
  text                String
  context             String?   // original passage / surrounding context
  counterpoint        String?
  useNote             String?   @map("use_note") // "where I could use this"
  sourceId            String?   @map("source_id")
  goalId              String?   @map("goal_id")
  status              String    @default("active") // active | archived
  reviewIntervalIndex Int       @default(0) @map("review_interval_index") // index into [1,3,7,14,30,90] days
  nextReviewAt        DateTime? @map("next_review_at")
  appliedCount        Int       @default(0) @map("applied_count")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  source       Source?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  goal         Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  tags         IdeaTag[]
  applications Application[]

  @@index([nextReviewAt])
  @@index([goalId])
  @@map("ideas")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ideas IdeaTag[]

  @@map("tags")
}

model IdeaTag {
  id        String   @id @default(cuid())
  ideaId    String   @map("idea_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([ideaId, tagId])
  @@map("idea_tags")
}

model Application {
  id        String   @id @default(cuid())
  ideaId    String   @map("idea_id")
  note      String
  appliedAt DateTime @default(now()) @map("applied_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@map("applications")
}
